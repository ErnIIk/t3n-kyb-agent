# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Both keys come from the same claim page, but they are TWO SEPARATE keys:
# https://docs.terminal3.io/developers/adk/get-started/prerequisites/request-test-tokens
#
# Despite the name, T3N_API_KEY is a secp256k1 private key (0x...), not a
# bearer token — the SDK signs the SIWE challenge with it.

# The tenant identity: owns the contract, the KV maps, and the user profile.
T3N_API_KEY=0x

# The agent identity: a DIFFERENT key with its own DID and its own credits.
# Reusing the tenant key here defeats the entire authorisation model, and the
# agent will fail with InsufficientCreditError if this key was never claimed.
#
# To get it: visit the claim page a SECOND time. Each visit issues a fresh key
# with its own credits — documented only on the org-agent page, not on the claim
# page itself (see BUGS.md #11).
T3N_AGENT_KEY=0x

# Printed by `npm run deploy` — did:t3n:... of the tenant.
T3N_TENANT_DID=did:t3n:

# Optional overrides
# T3N_ENV=testnet
# T3N_CONTRACT_TAIL=kyb-contracts

# Where submit-onboarding files the supplier record. httpbin echoes the request
# back, which makes the enclave-side placeholder substitution visible.
# Change both values together: the host must also be in the agent's grant.
ONBOARDING_URL=https://httpbin.org/post
ONBOARDING_HOST=httpbin.org
